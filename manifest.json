{
  "manifest_version": 3,
  "name": "memoppa - AIプロンプトが育つメモ帳",
  "version": "1.6.0",
  "description": "そのプロンプト、どこに置いた？新しいタブがAIの作業机になるメモ帳。プロンプトを登録して、2秒でコピー。全デバイスで同期。",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "identity"
  ]
}
